---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/pinyon-script/400.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '@fontsource/aref-ruqaa/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { site } from '../config/site';
import { t } from '../i18n';
import { type Lang, dir, swapLang, u, otherLang } from '../lib/url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  /** Pass false when a localized counterpart does not exist. */
  alternate?: boolean;
}
const { lang, title, description, image = '/og.png', type = 'website', jsonld = [], noindex = false, alternate = true } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const altHref = (to: Lang) => new URL(swapLang(path, to), Astro.site).href;
const ogImage = new URL(u(image), Astro.site).href;

const graph = [
  {
    '@type': ['Organization', 'ProfessionalService'],
    '@id': `${new URL(u('/'), Astro.site).href}#org`,
    name: site.name,
    url: new URL(u('/en/'), Astro.site).href,
    logo: new URL(u('/logo.svg'), Astro.site).href,
    image: ogImage,
    email: site.email,
    telephone: site.phone,
    founder: { '@id': `${new URL(u('/'), Astro.site).href}#founder` },
    areaServed: site.areaServed,
    address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
    sameAs: Object.values(site.social).filter(Boolean),
    knowsLanguage: ['en', 'ar'],
  },
  {
    '@type': 'Person',
    '@id': `${new URL(u('/'), Astro.site).href}#founder`,
    name: site.founder,
    alternateName: site.founderAr,
    jobTitle: 'Founder, Sdiek Marketing',
    worksFor: { '@id': `${new URL(u('/'), Astro.site).href}#org` },
    knowsAbout: ['Web development', 'SEO', 'Marketing automation', 'n8n', 'AI agents', 'Digital advertising', 'Branding', 'ERPNext'],
  },
  { '@type': 'WebSite', name: site.name, url: new URL(u('/'), Astro.site).href, inLanguage: [ 'en', 'ar' ] },
  ...jsonld,
];
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && (
      <>
        <link rel="alternate" hreflang="en" href={altHref('en')} />
        <link rel="alternate" hreflang="ar" href={altHref('ar')} />
        <link rel="alternate" hreflang="x-default" href={altHref('en')} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#e9ecf1" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_EG'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">{d.common.skip}</a>

    <!-- Preloader: counts 000 → 100 once per session -->
    <div class="preloader" aria-hidden="true">
      <div class="preloader__count script" data-count-load>000</div>
      <div class="preloader__meta caps"><span>{d.chrome.loading}</span><span class="preloader__track"><span class="preloader__bar"></span></span></div>
    </div>
    <div class="curtain" aria-hidden="true"><Logo size={56} wordmark={false} /></div>

    <canvas class="fluid" aria-hidden="true"></canvas>
    <div class="cursor" aria-hidden="true"><span class="cursor__label"></span></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>

    <Header lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />


    <div class="hover-preview" aria-hidden="true">
      <img alt="" width="480" height="300" />
      <span class="hover-preview__tag caps"></span>
    </div>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style is:global>
  /* Preloader */
  .preloader { position: fixed; inset: 0; z-index: 1800; background: var(--blue); color: #fff; display: grid; place-items: center; transition: clip-path 1.1s var(--ease-in-out); clip-path: inset(0 0 0 0); }
  .preloader.is-done { clip-path: inset(0 0 100% 0); }
  .preloader__count { color: #fff; font-size: clamp(7rem, 26vw, 22rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .preloader__meta { position: absolute; bottom: 40px; inset-inline: var(--gutter); display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .preloader__track { flex: 1; max-width: 320px; height: 1px; background: rgb(255 255 255 / 0.3); overflow: hidden; }
  .preloader__bar { display: block; height: 100%; background: #fff; transform-origin: 0 50%; transform: scaleX(0); }
  [dir='rtl'] .preloader__bar { transform-origin: 100% 50%; }
  html:not(.loaded) body { overflow: hidden; }

  /* Curtain (page leave) */
  .curtain { position: fixed; inset: 0; z-index: 1700; background: var(--blue); color: #fff; pointer-events: none; display: grid; place-items: center; transform: translateY(100%); transition: transform 0.5s var(--ease-in-out); }
  .curtain.leaving { transform: translateY(0); }

  /* Ledger */

  /* Hover preview */
  .hover-preview { position: fixed; top: 0; left: 0; z-index: 80; width: min(420px, 34vw); aspect-ratio: 16 / 10; pointer-events: none; opacity: 0; transition: opacity 0.35s var(--ease); border-radius: 6px; overflow: hidden; box-shadow: 0 30px 60px -20px rgb(11 20 36 / 0.45); }
  .hover-preview.on { opacity: 1; }
  .hover-preview img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hover-preview__tag { position: absolute; bottom: 10px; inset-inline-start: 10px; background: var(--blue); color: #fff; padding: 5px 9px; border-radius: 999px; }
</style>
