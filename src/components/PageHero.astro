---
// Inner-page header: uppercase title + optional script accent + lead.
interface Props { eyebrow?: string; title: string; script?: string; lead?: string }
const { eyebrow, title, script, lead } = Astro.props;
---
<section class="ph">
  <div class="wrap ph__inner">
    {eyebrow && <p class="caps blue" data-reveal>{eyebrow}</p>}
    <h1 class="ph__title" data-split>{title}</h1>
    {script && <p class="ph__script script" data-reveal style="--d:.35s">{script}</p>}
    {lead && <p class="lead" data-reveal style="--d:.45s">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .ph { position: relative; padding-top: clamp(140px, 16vw, 200px); padding-bottom: clamp(50px, 6vw, 80px); overflow: hidden; }
  .ph__inner .lead { max-width: 52ch; }
  .ph__inner { position: relative; z-index: 1; display: grid; gap: 22px; }
  .ph__title { font-size: clamp(2.8rem, 8vw, 7rem); line-height: 0.92; letter-spacing: -0.05em; }
  :root[lang='ar'] .ph__title { font-size: clamp(2.4rem, 6.4vw, 5.4rem); line-height: 1.25; letter-spacing: 0; }
  .ph__script { font-size: clamp(2rem, 4.4vw, 3.8rem); margin-top: -0.3em; margin-inline-start: 0.4em; }
</style>
