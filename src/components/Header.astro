---
import Logo from './Logo.astro';
import { t } from '../i18n';
import { type Lang, l, swapLang, otherLang } from '../lib/url';
import { site, waLink } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
const pages = [
  { href: l(lang, '/work/'), label: d.nav.work },
  { href: l(lang, '/services/'), label: d.nav.services },
  { href: l(lang, '/about/'), label: d.nav.about },
  { href: l(lang, '/blog/'), label: d.nav.blog },
  { href: l(lang, '/contact/'), label: d.nav.contact },
];
const socials = [
  { href: waLink(), label: 'WhatsApp' },
  { href: `mailto:${site.email}`, label: 'Email' },
  ...Object.entries(site.social).filter(([, v]) => v).map(([k, v]) => ({ href: v, label: k === 'x' ? 'X' : k[0].toUpperCase() + k.slice(1) })),
];
const isActive = (href: string) => path.startsWith(href);
---
<header class="hdr">
  <div class="hdr__bar">
    <a href={l(lang, '/')} class="hdr__logo" aria-label={site.name}><Logo /></a>

    <nav class="hdr__nav" aria-label="Primary">
      {pages.map((p) => (
        <a href={p.href} class:list={['hdr__link', { active: isActive(p.href) }]} aria-current={isActive(p.href) ? 'page' : undefined}>
          <span class="roll" data-text={p.label}><span>{p.label}</span></span>
        </a>
      ))}
    </nav>

    <div class="hdr__actions">
      <a href={swapLang(path, otherLang(lang))} class="hdr__lang" hreflang={otherLang(lang)} lang={otherLang(lang)}>{d.common.langName}</a>
      <a href={l(lang, '/book/')} class="btn btn--blue hdr__cta" data-magnetic="0.15">{d.nav.book}</a>
      <button class="hdr__burger" data-menu-toggle aria-expanded="false" aria-controls="menu-overlay" aria-label={d.nav.menu}>
        <span class="hdr__lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu-overlay" id="menu-overlay">
  <nav aria-label="Mobile">
    <ol>
      {[{ href: l(lang, '/'), label: d.nav.home }, ...pages].map((p, i) => (
        <li style={`--d:${0.05 * i + 0.1}s`}><a href={p.href}><span class="mono">0{i + 1}</span>{p.label}</a></li>
      ))}
    </ol>
    <div class="menu-overlay__foot">
      {socials.map((s) => <a href={s.href} class="caps" target="_blank" rel="noopener">{s.label}</a>)}
    </div>
    <a href={l(lang, '/book/')} class="btn menu-overlay__btn">{d.common.bookCall}</a>
  </nav>
</div>

<style>
  .hdr { position: fixed; top: 0; inset-inline: 0; z-index: 100; padding: 14px var(--gutter); }
  .hdr__bar { max-width: var(--max); margin-inline: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; padding: 10px 10px 10px 18px; border-radius: 999px; border: 1px solid transparent; transition: background 0.4s var(--ease), border-color 0.4s, box-shadow 0.4s, color 0.4s; }
  [dir='rtl'] .hdr__bar { padding: 10px 18px 10px 10px; }
  :global(html.scrolled) .hdr__bar { background: rgb(245 246 249 / 0.78); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); border-color: var(--line); box-shadow: 0 10px 30px -20px rgb(11 20 36 / 0.3); }
  :global(html.scrolled.header-dark) .hdr__bar { background: rgb(11 20 36 / 0.7); border-color: rgb(255 255 255 / 0.1); color: #fff; }
  .hdr__logo { justify-self: start; }
  .hdr__nav { display: flex; gap: 30px; }
  .hdr__link { font-size: 0.92rem; font-weight: 500; white-space: nowrap; position: relative; }
  .hdr__link.active { color: var(--blue); }
  .hdr__link.active::after { content: ''; position: absolute; left: 50%; bottom: -8px; width: 4px; height: 4px; border-radius: 50%; background: currentColor; transform: translateX(-50%); }
  :global(html.header-dark) .hdr__link.active { color: var(--blue-bright); }
  .hdr__actions { justify-self: end; display: flex; align-items: center; gap: 18px; }
  .hdr__lang { font-size: 0.9rem; font-weight: 500; opacity: 0.75; transition: opacity 0.3s; }
  .hdr__lang:hover { opacity: 1; }
  .hdr__cta { padding: 11px 20px; font-size: 0.8rem; }
  :global(html.header-dark) .hdr__logo, :global(html.header-dark) .hdr__nav, :global(html.header-dark) .hdr__lang { color: #fff; }
  .hdr__burger { display: none; width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: #fff; place-items: center; }
  .hdr__lines { display: grid; gap: 5px; width: 16px; }
  .hdr__lines i { height: 1.5px; background: currentColor; transition: transform 0.4s var(--ease); }
  :global(html.menu-open) .hdr__lines i:first-child { transform: translateY(3.25px) rotate(45deg); }
  :global(html.menu-open) .hdr__lines i:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  @media (max-width: 960px) {
    .hdr { padding: 10px 12px; }
    .hdr__bar { grid-template-columns: 1fr auto; }
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__burger { display: grid; }
    :global(html.menu-open) .hdr__bar { background: transparent !important; border-color: transparent !important; box-shadow: none !important; backdrop-filter: none !important; }
    :global(html.menu-open) .hdr__logo, :global(html.menu-open) .hdr__lang { color: #fff; }
    :global(html.menu-open) .hdr__burger { background: #fff; color: var(--blue); }
  }

  .menu-overlay { position: fixed; inset: 0; z-index: 95; background: var(--blue); color: #fff; padding: 110px var(--gutter) 40px; clip-path: circle(0% at 100% 0); transition: clip-path 0.9s var(--ease-in-out); overflow-y: auto; }
  [dir='rtl'] .menu-overlay { clip-path: circle(0% at 0 0); }
  :global(html.menu-open) .menu-overlay { clip-path: circle(150% at 100% 0); }
  .menu-overlay ol { list-style: none; padding: 0; display: grid; gap: 2px; margin-bottom: 36px; }
  .menu-overlay li { opacity: 0; transform: translateY(24px); transition: opacity 0.6s var(--ease) var(--d), transform 0.8s var(--ease) var(--d); }
  :global(html.menu-open) .menu-overlay li { opacity: 1; transform: none; }
  .menu-overlay li a { display: flex; align-items: baseline; gap: 14px; font-family: var(--f-display); font-size: clamp(2.2rem, 10vw, 4rem); text-transform: uppercase; letter-spacing: -0.04em; line-height: 1.1; }
  :root[lang='ar'] .menu-overlay li a { text-transform: none; letter-spacing: 0; line-height: 1.5; }
  .menu-overlay li .mono { font-size: 0.72rem; opacity: 0.6; }
  .menu-overlay__foot { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-bottom: 28px; }
  .menu-overlay__btn { --bg-btn: #fff; --fg-btn: var(--ink); }
</style>
