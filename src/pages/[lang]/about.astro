---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { t } from '../../i18n';
import { type Lang, l, langs } from '../../lib/url';
import { projects } from '../../data/projects';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t(lang);
const a = d.about;
const tools = [...new Set(projects.flatMap((p) => p.stack))].slice(0, 40);
const jsonld = [{ '@type': 'AboutPage', name: a.metaTitle, inLanguage: lang, mainEntity: { '@type': 'Person', name: 'Mohamed Ramadan' } }];
---
<Base lang={lang} title={a.metaTitle} description={a.metaDesc} jsonld={jsonld}>
  <PageHero eyebrow={a.title} title={a.hello} script={d.hero.roles[0]} />

  <section class="ab wrap">
    <aside class="ab__card" data-reveal>
      <!-- TODO: swap the initials for a real portrait (docs/MISSING.md) -->
      <div class="ab__avatar" aria-hidden="true">MR</div>
      <div class="ab__who">
        <p class="ab__name">{d.hero.name}</p>
        <p class="muted">{lang === 'ar' ? 'المؤسس · مسوّق يبرمج' : 'Founder · Marketer who codes'}</p>
      </div>
      <dl class="ab__facts">
        <div><dt class="caps muted">{lang === 'ar' ? 'المقر' : 'Based in'}</dt><dd>{lang === 'ar' ? 'القاهرة، مصر' : 'Cairo, Egypt'}</dd></div>
        <div><dt class="caps muted">{lang === 'ar' ? 'اللغات' : 'Languages'}</dt><dd>{lang === 'ar' ? 'العربية، الإنجليزية' : 'Arabic, English'}</dd></div>
        <div><dt class="caps muted">{lang === 'ar' ? 'المشاريع' : 'Projects'}</dt><dd>{projects.length}</dd></div>
        <div><dt class="caps muted">{lang === 'ar' ? 'الحالة' : 'Status'}</dt><dd class="ab__avail"><span class="dot-live"></span>{d.hero.available}</dd></div>
      </dl>
    </aside>
    <div class="ab__text">
      <p class="statement" data-reveal>{a.lead}</p>
      {a.body.map((p, i) => <p class="ab__p" data-reveal style={`--d:${0.1 * (i + 1)}s`}>{p}</p>)}
      <div class="btn-row" data-reveal>
        <a class="btn btn--blue" href={l(lang, '/book/')} data-magnetic="0.25">{d.common.bookCall}</a>
        <a class="btn btn--ghost" href={l(lang, '/work/')} data-magnetic="0.25">{d.home.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <section class="section ink-block pr" data-dark>
    <div class="wrap">
      <h2 class="pr__title"><span class="script">{a.principlesTitle}</span></h2>
      <ol class="pr__list">
        {a.principles.map((p, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <span class="mono" style="color:var(--blue-bright)">0{i + 1}</span>
            <h3 class="h3">{p.t}</h3>
            <p style="color:#aab6ca">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="caps">{a.toolboxTitle}</h2>
      <ul class="tb">{tools.map((tl, i) => <li class="tb__item" data-reveal style={`--d:${(i % 10) * 0.03}s`}>{tl}</li>)}</ul>
    </div>
  </section>
</Base>

<style>
  .ab { display: grid; gap: 50px; padding-bottom: 120px; }
  @media (min-width: 900px) { .ab { grid-template-columns: 0.8fr 1.3fr; align-items: start; gap: 80px; } }
  .ab__card { display: grid; gap: 24px; align-content: start; padding: 32px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  @media (min-width: 900px) { .ab__card { position: sticky; top: 110px; } }
  .ab__avatar { width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: #fff; font-family: var(--f-display); font-size: 2rem; font-weight: 600; letter-spacing: -0.03em; }
  .ab__name { font-family: var(--f-display); font-size: 1.6rem; font-weight: 500; letter-spacing: -0.03em; }
  .ab__facts { display: grid; border-top: 1px solid var(--line); }
  .ab__facts > div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .ab__facts dd { margin: 0; font-weight: 500; text-align: end; }
  .ab__avail { display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; }
  .ab__text { display: grid; gap: 24px; }
  .ab__text .statement { font-size: clamp(1.3rem, 2.2vw, 1.9rem); }
  .ab__p { font-size: 1.1rem; line-height: 1.75; max-width: 58ch; }
  .pr__title { text-align: center; margin-bottom: 60px; }
  .pr__title .script { font-size: clamp(2.8rem, 6vw, 5rem); color: #fff; }
  .pr__list { list-style: none; padding: 0; display: grid; gap: 30px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .pr__list li { display: grid; gap: 10px; border-top: 1px solid rgb(255 255 255 / 0.15); padding-top: 24px; }
  .tb { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .tb__item { font-family: var(--f-display); font-size: 1rem; letter-spacing: -0.01em; padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; transition: background 0.3s, color 0.3s; }
  .tb__item:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
</style>
