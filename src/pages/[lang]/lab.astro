---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ConfiguratorStudy from '../../components/studies/ConfiguratorStudy.astro';
import LayersStudy from '../../components/studies/LayersStudy.astro';
import JourneyStudy from '../../components/studies/JourneyStudy.astro';
import { t, pick } from '../../i18n';
import { type Lang, u, langs } from '../../lib/url';
import { inspiration } from '../../data/inspiration';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t(lang);
const L = d.lab;
const credit = (slug: string) => inspiration.find((i) => i.slug === slug)!;
const studies = [
  { key: 's1', n: '01', c: credit('teatika') },
  { key: 's2', n: '02', c: credit('alpeniq') },
  { key: 's3', n: '03', c: credit('asklex') },
] as const;
const jsonld = [{
  '@type': 'CollectionPage',
  name: L.metaTitle,
  inLanguage: lang,
  about: inspiration.map((i) => ({ '@type': 'WebSite', name: i.title, url: i.url, creator: { '@type': 'Organization', name: i.studio } })),
}];
---
<Base lang={lang} title={L.metaTitle} description={L.metaDesc} jsonld={jsonld}>
  <PageHero title={L.title} script={L.script} lead={L.lead} />

  <section class="wrap lab">
    <header class="sec-head">
      <div><p class="caps blue">01 — 03</p><h2 class="h2" data-split>{L.studiesTitle}</h2></div>
      <p class="lead" data-reveal>{L.studiesLead}</p>
    </header>

    {studies.map((s) => (
      <article class="study" id={`study-${s.n}`}>
        <header class="study__head" data-reveal>
          <span class="mono blue">{s.n}</span>
          <div>
            <h3 class="study__title">{L[s.key].t}</h3>
            <p class="muted">{L[s.key].d}</p>
          </div>
          <p class="study__credit caps">
            <span class="study__badge">{L.concept}</span>
            <span>{L.inspiredBy} <a class="ulink blue" href={s.c.awwwards} target="_blank" rel="noopener">{s.c.title}</a> {L.by} {s.c.studio}</span>
          </p>
        </header>
        {s.key === 's1' && <ConfiguratorStudy lang={lang} />}
        {s.key === 's2' && <LayersStudy lang={lang} />}
        {s.key === 's3' && <JourneyStudy lang={lang} />}
      </article>
    ))}
  </section>

  <section class="section board-sec">
    <div class="wrap">
      <header class="sec-head">
        <div><p class="caps blue">Awwwards</p><h2 class="h2" data-split>{L.boardTitle}</h2></div>
        <p class="lead" data-reveal>{L.boardLead}</p>
      </header>
      <div class="board">
        {inspiration.map((i, k) => (
          <article class="ins" data-reveal style={`--d:${(k % 3) * 0.06}s`}>
            <a class="ins__media" href={i.url} target="_blank" rel="noopener nofollow" data-cursor={L.visit}>
              <img src={u(`/inspiration/${i.image}`)} alt={`${i.title} — ${L.by} ${i.studio}`} width="1440" height="900" loading="lazy" decoding="async" />
            </a>
            <div class="ins__body">
              <div class="ins__row">
                <h3 class="ins__title">{i.title}</h3>
                <span class="caps muted">{pick(i.field, lang)}</span>
              </div>
              <p class="ins__by caps">{L.by} <strong>{i.studio}</strong></p>
              <p class="ins__take"><span class="caps blue">{L.takeaway}</span>{pick(i.takeaway, lang)}</p>
              <p class="ins__links caps">
                <a class="ulink" href={i.url} target="_blank" rel="noopener nofollow">{L.visit} ↗</a>
                <a class="ulink" href={i.awwwards} target="_blank" rel="noopener nofollow">{L.onAwwwards} ↗</a>
              </p>
            </div>
          </article>
        ))}
      </div>
      <p class="caps muted board__note">{L.fetched}</p>
    </div>
  </section>
</Base>

<style>
  .lab { padding-bottom: 60px; }
  .study { display: grid; gap: 26px; padding-block: 50px; border-top: 1px solid var(--line); }
  .study__head { display: grid; gap: 14px 22px; grid-template-columns: 40px 1fr; align-items: start; }
  @media (min-width: 900px) { .study__head { grid-template-columns: 50px 1fr auto; } }
  .study__title { font-size: clamp(1.4rem, 2.6vw, 2.1rem); text-transform: none; letter-spacing: -0.03em; }
  .study__head .muted { max-width: 56ch; margin-top: 6px; }
  .study__credit { grid-column: 2; display: grid; gap: 8px; justify-items: start; color: var(--muted); }
  @media (min-width: 900px) { .study__credit { grid-column: 3; justify-items: end; text-align: end; } }
  .study__badge { padding: 5px 10px; border-radius: 999px; background: var(--blue-soft); color: var(--blue-deep); }
  .board-sec { background: var(--surface); border-top: 1px solid var(--line); }
  .board { display: grid; gap: 40px 24px; }
  @media (min-width: 700px) { .board { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .board { grid-template-columns: repeat(3, 1fr); } }
  .ins { display: grid; gap: 16px; align-content: start; }
  .ins__media { display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 10px; border: 1px solid var(--line); background: var(--surface-2); }
  .ins__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1.1s var(--ease); }
  .ins:hover .ins__media img { transform: scale(1.04); }
  .ins__body { display: grid; gap: 8px; }
  .ins__row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .ins__title { font-size: 1.35rem; text-transform: none; letter-spacing: -0.02em; }
  .ins__by strong { color: var(--ink); font-weight: 600; }
  .ins__take { display: grid; gap: 4px; font-size: 0.95rem; color: var(--muted); }
  .ins__links { display: flex; gap: 18px; margin-top: 4px; }
  .board__note { margin-top: 40px; }
</style>
