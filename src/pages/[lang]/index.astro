---
import Base from '../../layouts/Base.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { t, pick } from '../../i18n';
import { type Lang, l, u, langs } from '../../lib/url';
import { projects, getProject } from '../../data/projects';
import { services } from '../../data/services';
import { approvedTestimonials } from '../../data/testimonials';
import { postsFor, postSlug, fmtDate } from '../../lib/blog';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t(lang);
const h = d.hero;
const posts = (await postsFor(lang)).slice(0, 3);
const featured = ['alsakr-online', 'qualifay', 'nexumotion', 'seo-content-factory', 'alsakr-conveying', 'walaa-3d']
  .map((s) => getProject(s)!)
  .filter(Boolean);
const facts = [
  { n: 39000, s: '+', l: d.home.proof[0].l },
  { n: 6, s: '', l: d.home.proof[1].l },
  { n: 10, s: '', l: d.home.proof[2].l },
  { n: 16, s: '', l: d.home.proof[3].l },
];
const arrow = '<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const heroFlow = lang === 'ar'
  ? ['زائر', 'الموقع والسيو', 'أتمتة n8n', 'عميل محتمل', 'تقرير يومي']
  : ['Visitor', 'Site + SEO', 'n8n automation', 'Qualified lead', 'Daily report'];
---
<Base lang={lang} title={d.meta.title} description={d.meta.description}>

  <!-- ═══ HERO ═══ -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="hero__status caps" data-reveal><span class="dot-live"></span>{h.available}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line" data-split>{h.titleA}</span>
        <span class="hero__line" data-split>{h.titleB}</span>
        <span class="hero__line hero__script script" data-reveal style="--d:.35s">{h.titleScript}</span>
      </h1>
      <p class="lead hero__lead" data-reveal style="--d:.45s">{h.intro}</p>
      <div class="btn-row" data-reveal style="--d:.55s">
        <a href={l(lang, '/book/')} class="btn btn--blue" data-magnetic="0.2"><span>{d.home.ctaPrimary}</span><Fragment set:html={arrow} /></a>
        <a href="#work" class="btn btn--ghost" data-magnetic="0.2">{d.home.ctaSecondary}</a>
      </div>
      <p class="hero__by caps muted" data-reveal style="--d:.65s">{h.byline}</p>
    </div>

    <aside class="hero__panel torn" data-reveal style="--d:.3s" aria-label={h.panelTitle}>
      <div class="hero__panel-head">
        <span class="caps">{h.panelTitle}</span>
        <span class="caps hero__live"><span class="dot-live"></span>{d.chrome.online}</span>
      </div>
      <ol class="hero__flow">
        {heroFlow.map((s, i) => (
          <li style={`--i:${i}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s}</li>
        ))}
      </ol>
      <p class="hero__panel-foot caps">{h.panelFoot}</p>
    </aside>
  </section>

  <!-- ═══ PROOF ═══ -->
  <section class="proof wrap" aria-label={d.home.proofTitle}>
    {facts.map((f, i) => (
      <div class="proof__item" data-reveal style={`--d:${i * 0.06}s`}>
        <span class="proof__n" dir="ltr"><span data-count={f.n} data-suffix={f.s}>0</span></span>
        <p class="muted">{f.l}</p>
      </div>
    ))}
  </section>

  <!-- ═══ WORK ═══ -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <p class="caps blue">{d.nav.work}</p>
          <h2 id="work-title" class="h2" data-split>{d.home.workTitle}</h2>
        </div>
        <p class="lead" data-reveal>{d.home.workLead}</p>
      </header>
      <div class="fw">
        {featured.map((p, i) => (
          <a href={l(lang, `/work/${p.slug}/`)} class="fw__card" data-cursor={d.common.view} data-reveal style={`--d:${(i % 2) * 0.08}s`}>
            <div class="fw__media">
              {p.image ? (
                <img src={u(`/work/${p.image}`)} alt={`${p.title} — ${pick(p.tagline, lang)}`} width="1440" height="900" loading="lazy" decoding="async" />
              ) : (
                <div class="fw__flow ink-block"><FlowDiagram steps={pick(p.flow, lang).slice(0, 4)} compact /></div>
              )}
            </div>
            <div class="fw__meta">
              <div class="fw__row">
                <h3 class="fw__title">{p.title}</h3>
                <span class="caps muted">{d.work.filters[p.category]}</span>
              </div>
              <p class="muted">{pick(p.tagline, lang)}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="center">
        <a href={l(lang, '/work/')} class="btn btn--ghost" data-magnetic="0.2">{d.common.allWork} ({projects.length})<Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- ═══ MANIFESTO ═══ -->
  <section class="mani section">
    <div class="wrap mani__inner">
      <p class="mani__a" data-reveal>{d.home.manifestoTitle}</p>
      <p class="mani__b" data-reveal style="--d:.15s">{d.home.manifestoBody}</p>
      <p class="lead mani__sub" data-reveal style="--d:.25s">{d.home.manifestoSub}</p>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="section svc-sec">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <p class="caps blue">{d.nav.services}</p>
          <h2 class="h2" data-split>{d.home.servicesTitle}</h2>
        </div>
        <p class="lead" data-reveal>{d.home.servicesLead}</p>
      </header>
      <div class="svc">
        {services.map((s, i) => (
          <a href={`${l(lang, '/services/')}#${s.id}`} class="svc__card" data-reveal style={`--d:${(i % 4) * 0.05}s`}>
            <svg class="svc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
            <h3 class="svc__title">{pick(s.title, lang)}</h3>
            <p class="muted">{pick(s.short, lang)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PROCESS ═══ -->
  <section class="proc section ink-block" data-dark aria-labelledby="proc-title">
    <div class="wrap">
      <header class="proc__head">
        <h2 id="proc-title" class="script proc__title">{d.home.processTitle}</h2>
      </header>
      <ol class="proc__steps">
        {d.home.process.map((s, i) => (
          <li class="proc__step" data-reveal style={`--d:${i * 0.07}s`}>
            <span class="mono proc__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="proc__h">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {approvedTestimonials.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="caps blue">{d.home.testimonialsTitle}</p>
        <div class="tst">
          {approvedTestimonials.map((tm) => (
            <figure class="tst__item" data-reveal>
              <blockquote class="statement">“{pick(tm.quote, lang)}”</blockquote>
              <figcaption class="caps muted">{pick(tm.name, lang)} — {pick(tm.role, lang)}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ JOURNAL ═══ -->
  {posts.length > 0 && (
    <section class="section jr">
      <div class="wrap">
        <header class="sec-head">
          <div>
            <p class="caps blue">{d.nav.blog}</p>
            <h2 class="script jr__script" data-reveal>{h.journalScript}</h2>
          </div>
          <p class="lead" data-reveal>{d.blog.lead}</p>
        </header>
        <div class="jr__grid">
          {posts.map((p, i) => (
            <a href={l(lang, `/blog/${postSlug(p.id)}/`)} class="jr__card" data-cursor={d.common.readMore} data-reveal style={`--d:${i * 0.07}s`}>
              <time class="caps muted" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, lang)}</time>
              <h3 class="jr__title">{p.data.title}</h3>
              <span class="caps blue">{p.data.readingMinutes} {d.common.minRead} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .center { display: flex; justify-content: center; margin-top: 56px; }

  /* HERO */
  .hero { min-height: 100svh; display: grid; align-items: center; gap: clamp(40px, 6vw, 90px); padding-top: 120px; padding-bottom: 60px; }
  @media (min-width: 1000px) { .hero { grid-template-columns: 1.25fr 0.85fr; } }
  @media (max-width: 999px) { .hero { min-height: 0; padding-top: 110px; } }
  .hero__copy { display: grid; gap: 26px; justify-items: start; }
  .hero__status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .hero__title { display: grid; font-size: clamp(3rem, 7.4vw, 6.6rem); line-height: 0.92; letter-spacing: -0.05em; }
  :root[lang='ar'] .hero__title { font-size: clamp(2.6rem, 6vw, 5.2rem); line-height: 1.25; }
  .hero__script { font-size: 1.12em; margin-top: -0.05em; padding-inline-start: 0.6em; }
  .hero__lead { max-width: 44ch; }
  .hero__by { margin-top: 6px; }
  .hero__panel { background: var(--blue); color: #fff; padding: 46px clamp(24px, 3vw, 40px); display: grid; gap: 26px; align-self: center; }
  .hero__panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 18px; border-bottom: 1px solid rgb(255 255 255 / 0.25); }
  .hero__live { display: inline-flex; align-items: center; gap: 8px; }
  .hero__flow { list-style: none; padding: 0; display: grid; gap: 10px; position: relative; }
  .hero__flow::before { content: ''; position: absolute; inset-block: 18px; inset-inline-start: 21px; width: 1px; background: rgb(255 255 255 / 0.35); }
  .hero__flow li { position: relative; display: flex; align-items: center; gap: 16px; padding: 12px 16px; border-radius: 10px; background: rgb(255 255 255 / 0.08); font-family: var(--f-display); font-weight: 500; font-size: 1.05rem;
    animation: flowpulse 6s var(--ease-in-out) infinite; animation-delay: calc(var(--i) * 1.2s); }
  .hero__flow .mono { width: 12px; flex: none; opacity: 0.75; font-size: 0.68rem; }
  @keyframes flowpulse { 0%, 22%, 100% { background: rgb(255 255 255 / 0.08); color: #fff; } 6%, 14% { background: #fff; color: var(--blue); } }
  .hero__panel-foot { opacity: 0.8; }

  /* PROOF */
  .proof { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .proof { grid-template-columns: repeat(4, 1fr); } }
  .proof__item { padding: 34px 24px 30px 0; display: grid; gap: 8px; align-content: start; }
  .proof__item + .proof__item { border-inline-start: 1px solid var(--line); padding-inline-start: 24px; }
  @media (max-width: 899px) { .proof__item:nth-child(3) { border-inline-start: 0; padding-inline-start: 0; } .proof__item:nth-child(n+3) { border-top: 1px solid var(--line); } }
  .proof__n { font-family: var(--f-display); font-size: clamp(2.4rem, 4.4vw, 3.8rem); letter-spacing: -0.05em; line-height: 1; color: var(--blue); font-weight: 500; }
  .proof__item p { font-size: 0.92rem; max-width: 28ch; }

  /* FEATURED WORK */
  .fw { display: grid; gap: 56px 32px; }
  @media (min-width: 800px) { .fw { grid-template-columns: 1fr 1fr; } }
  .fw__card { display: grid; gap: 18px; align-content: start; }
  .fw__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--line); }
  .fw__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1.2s var(--ease); }
  .fw__card:hover .fw__media img { transform: scale(1.04); }
  .fw__flow { position: absolute; inset: 0; display: grid; align-content: center; padding: clamp(18px, 3vw, 40px); }
  .fw__flow :global(.flow__list) { grid-template-columns: repeat(2, 1fr); }
  .fw__meta { display: grid; gap: 6px; }
  .fw__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .fw__title { font-size: clamp(1.4rem, 2.4vw, 2rem); letter-spacing: -0.03em; transition: color 0.3s; }
  .fw__card:hover .fw__title { color: var(--blue); }

  /* MANIFESTO */
  .mani { background: var(--surface); border-block: 1px solid var(--line); }
  .mani__inner { display: grid; gap: 14px; justify-items: center; text-align: center; }
  .mani__a { font-family: var(--f-display); font-size: clamp(1.3rem, 2.4vw, 2rem); color: var(--muted); letter-spacing: -0.02em; max-width: 30ch; }
  .mani__b { font-family: var(--f-display); font-size: clamp(2.2rem, 5vw, 4.4rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1; color: var(--blue); }
  .mani__sub { text-align: center; margin-top: 10px; }

  /* SERVICES */
  .svc { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .svc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .svc { grid-template-columns: repeat(4, 1fr); } }
  .svc__card { display: grid; gap: 12px; align-content: start; padding: 28px 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); transition: border-color 0.3s, transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .svc__card:hover { border-color: var(--blue); transform: translateY(-4px); box-shadow: 0 24px 50px -30px rgb(42 91 255 / 0.5); }
  .svc__icon { width: 30px; height: 30px; color: var(--blue); }
  .svc__title { font-size: 1.2rem; text-transform: none; letter-spacing: -0.02em; line-height: 1.2; }
  .svc__card p { font-size: 0.93rem; }

  /* PROCESS */
  .proc__head { margin-bottom: 56px; }
  .proc__title { font-size: clamp(2.8rem, 6vw, 5rem); color: #fff; }
  .proc__steps { list-style: none; padding: 0; display: grid; gap: 28px; }
  @media (min-width: 900px) { .proc__steps { grid-template-columns: repeat(5, 1fr); } }
  .proc__step { display: grid; gap: 10px; align-content: start; padding-top: 22px; border-top: 1px solid rgb(255 255 255 / 0.18); }
  .proc__n { color: var(--blue-bright); }
  .proc__h { font-size: 1.35rem; text-transform: none; letter-spacing: -0.02em; color: #fff; }
  .proc__step p { color: #a9b5c9; font-size: 0.93rem; }

  /* TESTIMONIALS */
  .tst { display: grid; gap: 40px; margin-top: 24px; }
  .tst__item { display: grid; gap: 14px; border-top: 1px solid var(--line); padding-top: 30px; }

  /* JOURNAL */
  .jr__script { font-size: clamp(3rem, 7vw, 5.6rem); }
  .jr__grid { display: grid; gap: 16px; }
  @media (min-width: 900px) { .jr__grid { grid-template-columns: repeat(3, 1fr); } }
  .jr__card { display: grid; gap: 16px; align-content: space-between; min-height: 230px; padding: 28px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); transition: border-color 0.3s, transform 0.5s var(--ease); }
  .jr__card:hover { border-color: var(--blue); transform: translateY(-4px); }
  .jr__title { font-size: 1.3rem; text-transform: none; letter-spacing: -0.02em; line-height: 1.25; }
</style>
