---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { t, pick } from '../../i18n';
import { type Lang, l, u, langs } from '../../lib/url';
import { projects } from '../../data/projects';
import { services } from '../../data/services';
import { approvedTestimonials } from '../../data/testimonials';
import { postsFor, postSlug, fmtDate } from '../../lib/blog';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t(lang);
const h = d.hero;
const posts = (await postsFor(lang)).slice(0, 3);
const work = projects.filter((p) => p.category !== 'lab');
const facts = [
  { n: 39000, s: '+', l: d.home.proof[0].l },
  { n: 6, s: '', l: d.home.proof[1].l },
  { n: 10, s: '', l: d.home.proof[2].l },
  { n: 16, s: '', l: d.home.proof[3].l },
];
const arrow = '<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base lang={lang} title={d.meta.title} description={d.meta.description}>

  <!-- ═══ HERO ═══ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="construct" aria-hidden="true">
      <svg viewBox="0 0 1000 600" preserveAspectRatio="none">
        <line data-draw x1="500" y1="0" x2="1000" y2="600" /><line data-draw x1="1000" y1="0" x2="500" y2="600" />
        <line data-draw x1="500" y1="300" x2="1000" y2="300" /><line data-draw x1="710" y1="0" x2="710" y2="600" />
        <rect data-draw x="500" y="0" width="210" height="300" /><line data-draw x1="0" y1="560" x2="1000" y2="560" />
      </svg>
    </div>

    <div class="hero__strip torn">
      <div class="hero__strip-inner" data-speed="-0.08" aria-hidden="true">
        <svg viewBox="0 0 400 300" class="hero__nodes">
          <g fill="none" stroke="rgb(255 255 255 / .35)">
            <path d="M40 60 C140 60 120 150 220 150 S320 240 380 240" /><path d="M40 240 C120 240 150 150 220 150" />
            <path d="M220 150 C280 150 300 60 380 60" />
          </g>
          <g fill="#fff"><circle cx="40" cy="60" r="6" /><circle cx="40" cy="240" r="6" /><circle cx="220" cy="150" r="9" /><circle cx="380" cy="60" r="6" /><circle cx="380" cy="240" r="6" /></g>
          <circle r="4" fill="#fff"><animateMotion dur="3s" repeatCount="indefinite" path="M40 60 C140 60 120 150 220 150 S320 240 380 240" /></circle>
          <circle r="4" fill="#fff"><animateMotion dur="3.6s" repeatCount="indefinite" path="M40 240 C120 240 150 150 220 150 C280 150 300 60 380 60" /></circle>
        </svg>
      </div>
      <div class="hero__rail hero__rail--in" aria-hidden="true" dir="ltr">
        <div class="rail" style="--speed:26s" data-skew><span>{h.rail}</span><span>{h.rail}</span></div>
      </div>
      <p class="hero__intro" data-reveal style="--d:.2s">{h.intro}</p>
    </div>

    <div class="hero__rail" aria-hidden="true" dir="ltr">
      <div class="rail" style="--speed:26s" data-skew>
        <span>{h.rail}</span><span>{h.rail}</span>
      </div>
    </div>

    <div class="hero__mark" aria-hidden="true">
      <div class="hero__mark-shadow" data-track="-18"><Logo size={420} wordmark={false} mono /></div>
      <div class="hero__mark-main" data-track="26"><Logo size={420} wordmark={false} /></div>
    </div>

    <div class="hero__bottom wrap">
      <h1 id="hero-title" class="hero__name">
        <span class="caps muted">{d.home.eyebrow}</span>
        <span class="hero__title" data-split>{h.name}</span>
      </h1>
      <ul class="hero__roles" data-reveal style="--d:.4s">
        {h.roles.map((r) => <li class="caps">{r}</li>)}
      </ul>
    </div>
    <div class="hero__ctas wrap" data-reveal style="--d:.55s">
      <a href={l(lang, '/book/')} class="btn btn--blue" data-magnetic="0.25"><span>{d.home.ctaPrimary}</span><Fragment set:html={arrow} /></a>
      <a href="#work" class="btn btn--ghost" data-magnetic="0.25">{d.home.ctaSecondary}</a>
    </div>
  </section>

  <!-- ═══ STATEMENT (pinned, scales with scroll) ═══ -->
  <section class="stmt" data-pin aria-label={`${h.statementA} ${h.statementScript} ${h.statementB}`}>
    <div class="stmt__sticky">
      <div class="construct" aria-hidden="true">
        <svg viewBox="0 0 1000 600" preserveAspectRatio="none">
          <line data-draw x1="0" y1="0" x2="1000" y2="600" /><line data-draw x1="0" y1="600" x2="1000" y2="0" />
          <circle data-draw cx="500" cy="300" r="290" />
        </svg>
      </div>
      <p class="stmt__text" aria-hidden="true">
        <span class="stmt__a">{h.statementA}</span>
        <span class="stmt__script script">{h.statementScript}</span>
        <span class="stmt__b">{h.statementB}</span>
      </p>
      <p class="stmt__sub caps">{d.home.manifestoTitle} <b class="blue">{d.home.manifestoBody}</b></p>
    </div>
  </section>

  <!-- ═══ ABOUT + FACTS ═══ -->
  <section class="facts" id="about">
    <div class="facts__left torn">
      <div class="facts__sticky">
        <p class="facts__scrub statement" data-scrub>{h.scrub}</p>
      </div>
    </div>
    <div class="facts__right">
      <p class="statement facts__lead" data-reveal>{d.home.manifestoSub}</p>
      {facts.map((f, i) => (
        <div class="fact" data-reveal style={`--d:${i * 0.08}s`}>
          <span class="fact__n" dir="ltr"><span data-count={f.n} data-suffix={f.s}>0</span></span>
          <p class="caps">{f.l}</p>
        </div>
      ))}
      <a href={l(lang, '/about/')} class="btn btn--ghost" data-magnetic="0.2">{d.nav.about}<Fragment set:html={arrow} /></a>
    </div>
  </section>

  <!-- ═══ EXPERTISE ═══ -->
  <section class="exp section">
    <div class="wrap">
      <div class="exp__head">
        <h2 class="h2" data-split>{d.home.servicesTitle}</h2>
        <p class="lead" data-reveal>{d.home.servicesLead}</p>
      </div>
      <ol class="exp__list">
        {services.map((s) => (
          <li>
            <a href={`${l(lang, '/services/')}#${s.id}`} class="exp__row" data-cursor={d.common.view}>
              <span class="mono exp__n">{s.n}</span>
              <span class="exp__title">{pick(s.title, lang)}</span>
              <span class="exp__short">{pick(s.short, lang)}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="exp__tools" aria-hidden="true" dir="ltr">
      <div class="rail" style="--speed:50s">
        <span>{d.home.marquee.join(' ✦ ')} ✦</span><span>{d.home.marquee.join(' ✦ ')} ✦</span>
      </div>
    </div>
  </section>

  <!-- ═══ WORK: sticky sidebar + list ═══ -->
  <section class="work section" id="work" aria-labelledby="work-title">
    <div class="wrap work__grid">
      <aside class="work__side">
        <div class="work__sticky">
          <h2 id="work-title" class="caps">{d.home.workTitle}</h2>
          <span class="work__num" data-work-num dir="ltr">01</span>
          <span class="work__cat caps blue" data-work-cat>{d.work.filters[work[0].category]}</span>
          <span class="work__title-side" data-work-title>{work[0].title}</span>
          <a href={l(lang, '/work/')} class="btn btn--ghost" data-magnetic="0.2">{d.common.allWork}<Fragment set:html={arrow} /></a>
        </div>
      </aside>
      <ol class="work__list">
        {work.map((p, i) => (
          <li data-work-item data-num={String(i + 1).padStart(2, '0')} data-cat={d.work.filters[p.category]} data-title={p.title}>
            <a href={l(lang, `/work/${p.slug}/`)} class="wrow" data-cursor={d.common.view}
               data-preview={p.image ? u(`/work/${p.image}`) : ''} data-preview-tag={pick(p.status, lang)}>
              <span class="mono wrow__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="wrow__title">{p.title}</span>
              <span class="wrow__tag caps">{d.work.filters[p.category]}</span>
              <span class="wrow__line">{pick(p.tagline, lang)}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ PROCESS: pinned beam ═══ -->
  <section class="proc" data-pin data-dark aria-labelledby="proc-title">
    <div class="proc__beam" aria-hidden="true"></div>
    <div class="wrap">
      <h2 id="proc-title" class="proc__title"><span class="script">{d.home.processTitle}</span></h2>
      <ol class="proc__steps">
        {d.home.process.map((s, i) => (
          <li class="proc__step" data-reveal>
            <span class="mono blue">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="proc__h script">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ AUDIENCES ═══ -->
  <section class="aud section--tight section">
    <div class="wrap">
      <h2 class="caps aud__h">{d.home.audienceTitle}</h2>
      <div class="aud__grid">
        {d.home.audiences.map((a, i) => (
          <article class="aud__card" data-reveal data-tilt style={`--d:${i * 0.08}s`}>
            <span class="mono blue">0{i + 1}</span>
            <h3 class="h3">{a.t}</h3>
            <p class="muted">{a.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {approvedTestimonials.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="caps">{d.home.testimonialsTitle}</h2>
        <div class="tst">
          {approvedTestimonials.map((tm) => (
            <figure class="tst__item" data-reveal>
              <blockquote class="statement">“{pick(tm.quote, lang)}”</blockquote>
              <figcaption class="caps muted">{pick(tm.name, lang)} — {pick(tm.role, lang)}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ JOURNAL ═══ -->
  {posts.length > 0 && (
    <section class="jr section">
      <div class="wrap">
        <div class="jr__head">
          <h2 class="jr__script script" data-reveal>{h.journalScript}</h2>
          <p class="lead" data-reveal>{d.blog.lead}</p>
        </div>
        <ol class="jr__list">
          {posts.map((p) => (
            <li>
              <a href={l(lang, `/blog/${postSlug(p.id)}/`)} class="jr__row" data-cursor={d.common.readMore}>
                <time class="caps muted" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, lang)}</time>
                <span class="jr__title">{p.data.title}</span>
                <span class="caps blue">{p.data.readingMinutes} {d.common.minRead}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
</Base>

<script>
  // Sticky work sidebar follows the row in view
  const num = document.querySelector<HTMLElement>('[data-work-num]');
  const cat = document.querySelector<HTMLElement>('[data-work-cat]');
  const title = document.querySelector<HTMLElement>('[data-work-title]');
  if (num && cat && title) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      num.textContent = el.dataset.num!; cat.textContent = el.dataset.cat!; title.textContent = el.dataset.title!;
      num.animate([{ transform: 'translateY(30%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 500, easing: 'cubic-bezier(.22,1,.36,1)' });
    }), { rootMargin: '-45% 0px -45% 0px' });
    document.querySelectorAll('[data-work-item]').forEach((el) => io.observe(el));
  }
</script>

<style>
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto auto; overflow: hidden; padding-top: 120px; }
  .hero__strip { position: absolute; top: 14%; bottom: 31%; inset-inline-start: 0; width: 50%; background: var(--blue); overflow: hidden; z-index: 1; }
  .hero__strip-inner { position: absolute; inset: -10% 0; display: grid; place-items: center; }
  .hero__nodes { width: 70%; opacity: 0.9; }
  .hero__intro { position: absolute; top: 32px; inset-inline-start: var(--gutter); max-width: 34ch; color: #fff; font-size: 0.92rem; line-height: 1.45; z-index: 3; }
  .hero__rail { position: absolute; inset-inline: 0; top: 50%; transform: translateY(-50%); z-index: 2; font-family: var(--f-display); font-weight: 500; font-size: clamp(5rem, 17vw, 17rem); line-height: 1; letter-spacing: -0.05em; text-transform: uppercase; pointer-events: none; overflow: hidden; color: var(--ink); z-index: 0; }
  /* white copy of the rail, clipped by the blue strip (strip spans 14%–69% of the hero) */
  .hero__rail--in { left: 0; right: auto; width: 200%; top: calc((50% - 14%) / 0.55); color: #fff; }
  [dir='rtl'] .hero__rail--in { left: auto; right: 0; }
  :root[lang='ar'] .hero__rail { letter-spacing: 0; font-size: clamp(4rem, 13vw, 12rem); }
  .hero__mark { position: absolute; top: 50%; left: 50%; width: clamp(240px, 34vw, 460px); aspect-ratio: 1; transform: translate(-50%, -50%); z-index: 3; perspective: 900px; pointer-events: none; }
  .hero__mark > div { position: absolute; inset: 0; display: grid; place-items: center; will-change: transform; }
  .hero__mark :global(svg) { width: 100%; height: 100%; }
  .hero__mark-shadow { color: var(--blue-soft); filter: blur(2px); }
  .hero__mark-main { color: var(--ink); filter: drop-shadow(0 40px 40px rgb(11 20 36 / 0.25)); }
  .hero__bottom { grid-row: 2; position: relative; z-index: 4; display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .hero__name { display: grid; gap: 10px; }
  .hero__title { font-size: clamp(2.6rem, 6.6vw, 6rem); letter-spacing: -0.05em; line-height: 0.9; }
  .hero__roles { list-style: none; padding: 0; text-align: end; display: grid; gap: 2px; }
  .hero__ctas { grid-row: 3; position: relative; z-index: 4; display: flex; gap: 12px; flex-wrap: wrap; padding-block: 26px 70px; }
  @media (max-width: 760px) {
    .hero { display: flex; flex-direction: column; min-height: 0; padding-top: 84px; }
    .hero__strip { position: relative; inset: auto; width: 100%; min-height: 300px; display: flex; align-items: flex-start; }
    .hero__intro { position: relative; top: auto; inset-inline: auto; padding: 42px var(--gutter) 60px; font-size: 1.05rem; }
    .hero__strip-inner { opacity: 0.35; }
    .hero__mark { position: relative; top: auto; left: auto; transform: none; width: 190px; margin: -70px auto 0; }
    .hero__rail { position: relative; top: auto; transform: none; margin-top: -20px; opacity: 0.12; }
    .hero__rail--in { display: none; }
    .hero__bottom { margin-top: 10px; }
    .hero__roles { text-align: start; }
    .hero__ctas { padding-bottom: 50px; }
  }

  /* STATEMENT */
  .stmt { height: 220vh; position: relative; }
  .stmt__sticky { position: sticky; top: 0; height: 100vh; display: grid; place-items: center; overflow: hidden; }
  .stmt__text { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; font-family: var(--f-display); text-transform: uppercase; font-size: clamp(3.4rem, 13vw, 13rem); line-height: 0.82; letter-spacing: -0.06em; font-weight: 500;
    transform: scale(calc(0.7 + var(--prog, 0) * 0.45)); }
  :root[lang='ar'] .stmt__text { text-transform: none; letter-spacing: 0; line-height: 1.25; font-size: clamp(2.8rem, 10vw, 9rem); }
  .stmt__a { color: var(--blue); }
  .stmt__script { position: relative; z-index: 2; margin-block: -0.32em; font-size: 1.05em; transform: rotate(-6deg) translateX(calc((var(--prog, 0) - 0.5) * 18vw)); }
  .stmt__b { color: var(--blue); }
  .stmt__sub { position: absolute; bottom: 70px; inset-inline: var(--gutter); text-align: center; max-width: 60ch; margin-inline: auto; opacity: calc(var(--prog, 0) * 2 - 0.5); }

  @media (max-width: 760px) { .stmt { height: 170vh; } .stmt__text { font-size: 18vw; } }

  /* FACTS */
  .facts { display: grid; grid-template-columns: 1fr; position: relative; }
  @media (min-width: 900px) { .facts { grid-template-columns: 1fr 1fr; } }
  .facts__left { background: var(--blue); color: #fff; }
  .facts__sticky { position: sticky; top: 0; min-height: 100vh; display: grid; align-items: center; padding: 120px var(--gutter); }
  .facts__scrub { font-size: clamp(1.4rem, 2.6vw, 2.4rem); }
  .facts__scrub :global(.sw) { opacity: 0.25; }
  .facts__scrub :global(.sw.on) { opacity: 1; }
  .facts__right { padding: clamp(80px, 10vw, 140px) var(--gutter); display: grid; gap: 0; align-content: start; }
  .facts__lead { margin-bottom: 60px; max-width: 26ch; }
  .fact { display: grid; gap: 8px; padding-block: 34px; border-top: 1px solid var(--line); }
  .fact__n { font-family: var(--f-display); font-size: clamp(4rem, 10vw, 9rem); line-height: 0.9; letter-spacing: -0.06em; font-weight: 500; color: var(--blue); }
  .fact p { max-width: 36ch; }
  .facts__right > .btn { justify-self: start; margin-top: 30px; }

  /* EXPERTISE */
  .exp__head { display: grid; gap: 20px; margin-bottom: 60px; }
  @media (min-width: 900px) { .exp__head { grid-template-columns: 1.4fr 1fr; align-items: end; } }
  .exp__list { list-style: none; padding: 0; border-top: 1px solid var(--ink); }
  .exp__row { position: relative; display: grid; grid-template-columns: 50px 1fr; gap: 6px 20px; padding: 26px 0; border-bottom: 1px solid var(--line); overflow: hidden; isolation: isolate; transition: color 0.4s var(--ease), padding 0.5s var(--ease); }
  @media (min-width: 900px) { .exp__row { grid-template-columns: 70px 1.2fr 1fr; align-items: center; } }
  .exp__row::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--blue); transform: scaleY(0); transform-origin: bottom; transition: transform 0.55s var(--ease); }
  .exp__row:hover { color: #fff; padding-inline: 20px; }
  .exp__row:hover::before { transform: scaleY(1); }
  .exp__title { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(1.6rem, 3.6vw, 3.2rem); letter-spacing: -0.04em; line-height: 1; font-weight: 500; }
  :root[lang='ar'] .exp__title { text-transform: none; letter-spacing: 0; line-height: 1.4; }
  .exp__short { grid-column: 2; color: var(--muted); font-size: 0.95rem; transition: color 0.4s; }
  @media (min-width: 900px) { .exp__short { grid-column: 3; } }
  .exp__row:hover .exp__short, .exp__row:hover .exp__n { color: #dbe4ff; }
  .exp__n { color: var(--blue); }
  .exp__tools { margin-top: 90px; font-family: var(--f-display); font-size: clamp(1.6rem, 4vw, 3.4rem); text-transform: uppercase; letter-spacing: -0.03em; color: var(--muted); overflow: hidden; border-block: 1px solid var(--line); padding-block: 18px; }

  /* WORK */
  .work { background: var(--surface); }
  .work__grid { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .work__grid { grid-template-columns: 0.8fr 2fr; } }
  .work__sticky { position: sticky; top: 120px; display: grid; gap: 10px; justify-items: start; }
  .work__num { font-family: var(--f-display); font-size: clamp(6rem, 14vw, 13rem); line-height: 0.85; letter-spacing: -0.07em; color: var(--blue); font-variant-numeric: tabular-nums; }
  .work__title-side { font-family: var(--f-display); font-size: 1.4rem; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: 18px; }
  @media (max-width: 999px) { .work__num, .work__cat, .work__title-side { display: none; } .work__sticky { position: static; } }
  .work__list { list-style: none; padding: 0; border-top: 1px solid var(--ink); }
  .wrow { display: grid; grid-template-columns: 40px 1fr auto; gap: 8px 18px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--line); transition: padding 0.5s var(--ease); }
  .wrow:hover { padding-inline-start: 18px; }
  .wrow__n { color: var(--muted); }
  .wrow__title { font-family: var(--f-display); font-size: clamp(1.8rem, 4.4vw, 4rem); text-transform: uppercase; letter-spacing: -0.045em; line-height: 0.95; font-weight: 500; transition: color 0.3s; }
  .wrow:hover .wrow__title { color: var(--blue); }
  .wrow__line { grid-column: 2 / -1; color: var(--muted); max-width: 60ch; font-size: 0.95rem; }

  /* PROCESS */
  .proc { position: relative; padding-block: clamp(110px, 14vw, 200px); overflow: hidden; background: var(--ink); color: #e3e9f3; }
  .proc__beam { position: absolute; top: 0; bottom: 0; left: 50%; width: 140px; transform: translateX(-50%); pointer-events: none;
    background: radial-gradient(closest-side, rgb(42 91 255 / 0.95), rgb(20 168 255 / 0.4) 40%, transparent 100%);
    filter: blur(18px); opacity: calc(0.35 + var(--prog, 0) * 0.65); animation: beam 4s ease-in-out infinite alternate; }
  .proc__beam::after { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 3px; transform: translateX(-50%); background: #9fc2ff; filter: blur(1px); }
  @keyframes beam { to { width: 220px; } }
  .proc__title { text-align: center; margin-bottom: 80px; position: relative; }
  .proc__title .script { font-size: clamp(3rem, 8vw, 7rem); color: #fff; }
  .proc__steps { list-style: none; padding: 0; display: grid; gap: 80px; position: relative; }
  .proc__step { max-width: 420px; display: grid; gap: 10px; }
  .proc__step:nth-child(even) { justify-self: end; text-align: end; }
  .proc__h { font-size: clamp(2.4rem, 5vw, 4.2rem); color: var(--blue-bright); }
  .proc__step p { color: #aab6ca; }
  @media (max-width: 760px) { .proc__step:nth-child(even) { justify-self: start; text-align: start; } .proc__beam { left: 12%; } }

  /* AUDIENCES */
  .aud__h { margin-bottom: 30px; }
  .aud__grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
