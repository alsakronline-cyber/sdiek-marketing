---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../../i18n';
import { type Lang, l } from '../../../lib/url';
import { postSlug, fmtDate } from '../../../lib/blog';
import { site } from '../../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { lang: post.data.lang, slug: postSlug(post.id) }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const { Content } = await render(post);
const hasTwin = all.some((p) => p.data.key === post.data.key && p.data.lang !== lang && postSlug(p.id) === postSlug(post.id));
const related = all.filter((p) => p.data.lang === lang && p.id !== post.id).slice(0, 2);
const url = new URL(l(lang, `/blog/${postSlug(post.id)}/`), Astro.site).href;
const jsonld = [
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    inLanguage: lang,
    url,
    mainEntityOfPage: url,
    keywords: post.data.tags.join(', '),
    author: { '@type': 'Person', name: site.founder },
    publisher: { '@type': 'Organization', name: site.name },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: d.nav.home, item: new URL(l(lang, '/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: d.blog.title, item: new URL(l(lang, '/blog/'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base lang={lang} title={`${post.data.title} | Sdiek Marketing`} description={post.data.description} type="article" jsonld={jsonld} alternate={hasTwin}>
  <article class="wrap post">
    <header class="post__head">
      <a href={l(lang, '/blog/')} class="caps ulink">← {d.blog.title}</a>
      <div class="caps muted post__meta">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date, lang)}</time>
        <span>·</span><span>{post.data.readingMinutes} {d.common.minRead}</span>
        <span>·</span><span>{site.founder}</span>
      </div>
      <h1 class="post__title" data-split="words">{post.data.title}</h1>
      <p class="lead" data-reveal>{post.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
    <aside class="post__cta blue-block torn">
      <p class="statement">{d.home.ctaBody}</p>
      <a class="btn" href={l(lang, '/book/')} style="--bg-btn:#fff;--fg-btn:var(--ink)">{d.common.bookCall}</a>
    </aside>
    {related.length > 0 && (
      <nav class="post__rel" aria-label={d.blog.related}>
        <p class="caps blue">{d.blog.related}</p>
        {related.map((r) => <a class="post__rel-a" href={l(lang, `/blog/${postSlug(r.id)}/`)}>{r.data.title} →</a>)}
      </nav>
    )}
  </article>
</Base>

<style>
  .post { padding-top: clamp(140px, 18vw, 200px); padding-bottom: 100px; display: grid; gap: 50px; justify-items: center; }
  .post__head { display: grid; gap: 20px; max-width: 70ch; width: 100%; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .post__title { font-size: clamp(2.2rem, 5.4vw, 4.6rem); text-transform: none; letter-spacing: -0.04em; line-height: 1.02; }
  .prose { width: 100%; }
  .post__cta { width: 100%; max-width: 70ch; padding: 50px 36px; display: grid; gap: 20px; justify-items: start; }
  .post__rel { width: 100%; max-width: 70ch; display: grid; gap: 10px; }
  .post__rel-a { font-family: var(--f-display); font-size: 1.3rem; padding: 14px 0; border-bottom: 1px solid var(--line); transition: color 0.3s; }
  .post__rel-a:hover { color: var(--blue); }
</style>
